{
  "name": "travel-agent-zero",
  "version": "1.0.0",
  "description": "A retro-futuristic travel planning companion",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/build-index.js",
    "dev": "next dev",
    "prebuild": "node scripts/build-index.js",
    "build": "next build",
    "postbuild": "node scripts/minify-data.js",
    "lint": "eslint",
    "deploy": "npm run build && node -e \"require('fs').writeFileSync('out/.nojekyll','')\"",
    "validate": "node scripts/validate-data.js",
    "build:data": "node scripts/build-data.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5"
  }
}
